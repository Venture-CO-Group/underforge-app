{
  "name": "glow360",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:wearables": "ts-node --transpile-only -P tests/frontend/wearables/tsconfig.json tests/frontend/wearables/run.ts",
    "generate-version": "node ./scripts/generate-version.js",
    "generate-licenses": "node ./scripts/generate-licenses.js",
    "data-model": "node ./scripts/generate-data-model.js",
    "data-model:check": "node ./scripts/generate-data-model.js --check",
    "exercise-catalog": "node ./scripts/generate-exercise-catalog-doc.js",
    "exercise-catalog:check": "node ./scripts/generate-exercise-catalog-doc.js --check",
    "sync-contracts": "node ./scripts/sync-contracts.js",
    "build-wizard": "node ./scripts/build-wizard.js",
    "wizard": "npm run build-wizard",
    "prestart": "npm run generate-version && npm run generate-licenses && npm run data-model && npm run exercise-catalog",
    "preandroid": "npm run generate-version && npm run generate-licenses && npm run data-model && npm run exercise-catalog",
    "preios": "npm run generate-version && npm run generate-licenses && npm run data-model && npm run exercise-catalog",
    "preweb": "npm run generate-version && npm run generate-licenses && npm run data-model && npm run exercise-catalog",
    "eas-build-pre-install": "node ./scripts/generate-version.js",
    "eas-build-post-install": "node ./scripts/generate-version.js && node ./scripts/generate-licenses.js",
    "postinstall": "patch-package"
  },
